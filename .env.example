# Finora cloud storage is optional. Leave both fields empty for local-only mode.
# Find the project URL and PUBLIC anon / publishable key in Supabase Settings -> API.
# The publishable key is intended for a browser; server secrets are NEVER used here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth itself is configured inside Supabase Auth -> Providers -> Google.
# Do not put Google's client secret, service_role key or OAuth tokens in this file.
# Add https://YOUR-PROJECT.supabase.co/auth/v1/callback as a redirect in Google Cloud.
# Add https://finora-nine-self.vercel.app/auth/callback and
# http://localhost:3000/auth/callback to Supabase Auth -> URL configuration.
